# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

# PostgreSQL connection string used by SQLAlchemy + psycopg (v3 driver).
DATABASE_URL=postgresql+psycopg://username:password@host:5432/drink_tracker

# Default price charged per drink packet (RM). Used only as a fallback
# when a caller does not explicitly supply a price.
DEFAULT_PRICE_PER_PACKET=25.00

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60